{
  "manifest_version": 3,
  "name": "LiveCaption (AI雙語字幕 + 同傳配音)",
  "version": "2.2.0",
  "description": "即時影片語音辨識、雙語字幕與同傳配音 (SenseVoice + Edge-TTS + Audio Ducking + 智能鎖步對齊)",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
